# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
RELAY_SESSION_SECRET=

# Leave at 1 for HTTPS deployment. Set to 0 only for local HTTP verification.
RELAY_COOKIE_SECURE=1

# Persistent server-side SQLite file. Use a mounted volume in production.
RELAY_DB_PATH=.data/arcadeops-relay.sqlite

# Strict judge-mode limits.
RELAY_SESSION_TTL_MINUTES=120
RELAY_MAX_MISSIONS_PER_SESSION=2
RELAY_MAX_COST_USD=0.02
